# PrymCare Health — browser caching for static assets on Netlify
# This file is read automatically by Netlify on every deploy — no build step needed.

# Product images and other SVGs
/assets/products/*
  Cache-Control: public, max-age=31536000, immutable
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

# Logo and other top-level images
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

# CSS and JS
/assets/css/*
  Cache-Control: public, max-age=2592000
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

/assets/js/*
  Cache-Control: public, max-age=2592000
  Expires: Fri, 31 Dec 2035 23:59:59 GMT

# HTML — never cache, since prices/products change
/*.html
  Cache-Control: no-cache, must-revalidate
